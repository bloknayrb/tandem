  "cards": [
    {
      "dot": "cyan",
      "title": "Creation & Origin Tagging",
      "items": [
        "Every Y.Doc write goes through one of six origins.ts wrappers before landing in Y.Map('annotations')",
        "Only withBrowser-origin writes emit channel events"
      ]
    },
    {
      "dot": "rose",
      "title": "Privacy Guard (ADR-027)",
      "items": [
        "note/private: invisible on read; isPrivateForClaude gates edit/reply, isWithheldFromClaude resolve/remove",
        "addUserReply and removeAnnotationRecord (browser Archive) are deliberately unguarded"
      ]
    },
    {
      "dot": "amber",
      "title": "Anchoring & Recovery",
      "items": [
        "A stale RelativePosition marks the annotation anchor: degraded, not deleted",
        "Accepting a comment with suggestedText rewrites the stored flat span verbatim"
      ]
    }
  ]
