# Tandem environment variables (all optional — defaults shown)

# Server ports
TANDEM_PORT=3478          # Hocuspocus WebSocket port
TANDEM_MCP_PORT=3479      # MCP HTTP + REST API port (the stdio bridge also reads it)

# Channel shim
TANDEM_URL=http://127.0.0.1:3479  # Server URL for channel shim to connect to

# Transport mode (http or stdio)
TANDEM_TRANSPORT=http

# Skip auto-opening sample/welcome.md on first run
# TANDEM_NO_SAMPLE=1

# Claude Code executable the auto-launcher spawns (and the CLI-detection probe).
# Bare name resolves against PATH; a full path also works.
# TANDEM_CLAUDE_CMD=claude

# Auth. (Listening on a LAN address is not in this version, ADR-056: a
# non-loopback TANDEM_BIND_HOST is refused at start.)
# TANDEM_BIND_HOST=127.0.0.1   # only 127.0.0.1, localhost or ::1 are accepted
# TANDEM_AUTH_TOKEN=...   # override the auto-generated token; blocks `tandem rotate-token`

# Crash reporting — off unless you set this. Must be a DSN you control.
# TANDEM_SENTRY_DSN=https://key@sentry.example.com/1

# Startup behavior
# TANDEM_DISABLE_FIRST_RUN_WIZARD=1   # skip the first-run integration wizard
# TANDEM_DISABLE_LAUNCHER=1           # never auto-launch Claude Code
# TANDEM_OPEN_FILE=/abs/path/doc.md   # open this file at startup

# Advanced
# TANDEM_REQUEST_TIMEOUT_MS=30000
# TANDEM_APP_DATA_DIR=/custom/path
# TANDEM_DATA_DIR=/custom/repo/path   # locates sample/welcome.md; NOT app data
# TANDEM_ANNOTATION_STORE=off
# TANDEM_LICENSE_GATE=1               # force the license gate on in tsx/vitest only

# Development and tests only (see docs/configuration.md)
# TANDEM_MODELS_DEV_ORIGIN=http://127.0.0.1:5173  # one extra page that may change model settings; server run from source only
# TANDEM_DOCX=1                       # .docx on in tsx/vitest only
# TANDEM_OWNERSHIP=1                  # multi-session ownership on in tsx/vitest only
# TANDEM_CLIENT_CONFIG_HOME=/tmp/claude-home  # stand-in home for Claude configs; ignored by release builds
# TANDEM_FORCE_V1_WALKTHROUGH=1       # from the next release: show the v1.0 walkthrough on a non-1.0 build

# Set by the Tauri runtime — listed for reference, not for manual use.
# TANDEM_TAURI_SIDECAR=1
# TANDEM_DEFER_LAUNCHER=1
# TANDEM_DISABLE_AUTOSTART=1
# TANDEM_CHANNEL_DIST=/path/to/dist/channel/index.js
# TANDEM_STDIO_BRIDGE_DIST=/path/to/dist/stdio-bridge/index.js
# TANDEM_REAPER_PATH=/path/to/tandem-reaper
