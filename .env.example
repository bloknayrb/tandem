# Tandem environment variables (all optional — defaults shown)

# Server ports
TANDEM_PORT=3478          # Hocuspocus WebSocket port
TANDEM_MCP_PORT=3479      # MCP HTTP + REST API port

# Channel shim
TANDEM_URL=http://127.0.0.1:3479  # Server URL for channel shim to connect to

# Transport mode (http or stdio)
TANDEM_TRANSPORT=http

# Skip auto-opening sample/welcome.md on first run
# TANDEM_NO_SAMPLE=1

# Claude Code executable name (for tandem setup auto-detection)
# TANDEM_CLAUDE_CMD=claude

# LAN exposure & auth (v0.7.0+)
# TANDEM_BIND_HOST=0.0.0.0
# TANDEM_ALLOW_UNAUTHENTICATED_LAN=1
# TANDEM_LAN_IP=192.168.1.100

# Crash reporting — off unless you set this. Must be a DSN you control.
# TANDEM_SENTRY_DSN=https://key@sentry.example.com/1

# Startup behavior
# TANDEM_DISABLE_FIRST_RUN_WIZARD=1   # skip the first-run integration wizard
# TANDEM_DISABLE_LAUNCHER=1           # never auto-launch Claude Code
# TANDEM_OPEN_FILE=/abs/path/doc.md   # open this file at startup

# Advanced
# TANDEM_REQUEST_TIMEOUT_MS=30000
# TANDEM_APP_DATA_DIR=/custom/path
# TANDEM_DATA_DIR=/custom/repo/path   # locates sample/welcome.md; NOT app data
# TANDEM_ANNOTATION_STORE=off
# TANDEM_LICENSE_GATE=1               # force the license gate on in tsx/vitest only

# Set by the Tauri runtime — listed for reference, not for manual use.
# TANDEM_TAURI_SIDECAR=1
# TANDEM_DEFER_LAUNCHER=1
# TANDEM_DISABLE_AUTOSTART=1
# TANDEM_CHANNEL_DIST=/path/to/dist/channel/index.js
